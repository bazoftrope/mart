# PostgreSQL connection
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/marathon_platform

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Admin credentials
# Первый вход: используйте эти данные на странице /login
# Для генерации хеша: node -e "console.log(require('bcrypt').hashSync('ваш_пароль', 10))"
# Важно: экранируй $ в хеше обратным слэшем: \$2b\$10\$...
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=\$2b\$10\$replace-with-real-bcrypt-hash

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Загруженные файлы марафонов (аудио и PDF, локальное хранилище)
# По умолчанию: <project>/data/uploads/audio
UPLOAD_DIR=./data/uploads/audio

# Максимальный размер PDF-вложения, МБ (по умолчанию 25)
MAX_FILE_SIZE_MB=25

# Максимальный размер изображения, МБ (по умолчанию 10)
MAX_IMAGE_SIZE_MB=10

# Резервное копирование БД (scripts/db-backup.sh, см. DOC/architecture.md)
# Каталог для дампов. Держите его вне тома postgres и, желательно, вне репозитория.
# По умолчанию: $HOME/marathon-backups
# BACKUP_DIR=/home/ubuntu/marathon-backups
# Сколько последних дампов хранить. 1 — одна перезаписываемая копия.
# BACKUP_KEEP=1
# Расписание cron для `npm run db:backup:install-cron` (по умолчанию ежедневно в 03:00).
# BACKUP_CRON="0 3 * * *"
